# =====================================================================
# .env.example — copy to .env for local overrides.
# .env is git-ignored. NEVER commit real credentials.
# =====================================================================

# Active Spring profile: local | dev | stg | prod
SPRING_PROFILES_ACTIVE=local

# Database (PostgreSQL). local 프로필은 미설정 시 아래 값의 default 로 부팅됨.
# dev/stg/prod 는 필수.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=boilerplate
DB_USERNAME=boilerplate
DB_PASSWORD=local1234
